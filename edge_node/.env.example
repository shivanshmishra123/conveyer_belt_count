# ============================================================
# Edge Node — Environment Variables TEMPLATE
# ============================================================
# SAFE TO COMMIT. No real secrets here.
#
# Usage:
#   cp .env.example .env
#   Fill in your actual RTSP URL, belt ID etc. in .env
# ============================================================

# --- Belt Identity ---
BELT_ID=belt_01

# --- Camera Stream ---
# Use full RTSP URL in production.
# Use a local .mp4 path for local development/testing.
VIDEO_SOURCE=rtsp://admin:PASSWORD@CAMERA_IP:554/h264Preview_01_main

# --- Backend API ---
FASTAPI_BASE_URL=http://BACKEND_SERVER_IP:8000

# --- Detection Tuning ---
COUNTING_LINE_X=100
